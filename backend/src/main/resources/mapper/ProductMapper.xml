<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.mapper.ProductMapper">
  <select id="lockCategories" resultType="long">SELECT id FROM crm_product_category ORDER BY id FOR UPDATE</select>
  <select id="categories" resultType="com.crm.vo.ProductCategoryVO">SELECT id,parent_id,category_name,category_code,sort_no,status FROM crm_product_category WHERE deleted=0 ORDER BY sort_no,id</select>
  <select id="category" resultType="com.crm.entity.ProductCategory">SELECT id,parent_id,category_name,category_code,sort_no,status FROM crm_product_category WHERE id=#{id} AND deleted=0</select>
  <insert id="insertCategory" useGeneratedKeys="true" keyProperty="id">INSERT INTO crm_product_category(parent_id,category_name,category_code,sort_no,status) VALUES(#{parentId},#{categoryName},#{categoryCode},#{sortNo},#{status})</insert>
  <update id="updateCategory">UPDATE crm_product_category SET parent_id=#{parentId},category_name=#{categoryName},sort_no=#{sortNo},status=#{status} WHERE id=#{id}</update>
  <select id="countChildren" resultType="int">SELECT COUNT(*) FROM crm_product_category WHERE parent_id=#{id} AND deleted=0</select>
  <select id="countProducts" resultType="int">SELECT COUNT(*) FROM crm_product WHERE category_id=#{categoryId}</select>
  <update id="deleteCategory">UPDATE crm_product_category SET deleted=1 WHERE id=#{id}</update>
  <sql id="productDetail">SELECT p.*,c.category_name,(SELECT COUNT(*) FROM crm_product_sku s WHERE s.product_id=p.id) AS sku_count FROM crm_product p JOIN crm_product_category c ON c.id=p.category_id</sql>
  <sql id="productWhere"> WHERE 1=1
    <if test="keyword != null and keyword != ''">AND (p.model_code LIKE CONCAT('%',#{keyword},'%') OR p.product_name LIKE CONCAT('%',#{keyword},'%'))</if>
    <if test="categoryIds != null">AND p.category_id IN <foreach collection="categoryIds" item="id" open="(" separator="," close=")">#{id}</foreach></if>
    <if test="status != null">AND p.status=#{status}</if>
    <if test="supplyType != null">AND p.supply_type=#{supplyType}</if>
  </sql>
  <select id="list" resultType="com.crm.vo.ProductVO">
    <include refid="productDetail"/><include refid="productWhere"/> ORDER BY p.id
  </select>
  <select id="page" resultType="com.crm.vo.ProductVO"><include refid="productDetail"/><include refid="productWhere"/> ORDER BY p.id LIMIT #{size} OFFSET #{offset}</select>
  <select id="count" resultType="long">SELECT COUNT(*) FROM crm_product p <include refid="productWhere"/></select>
  <select id="detail" resultType="com.crm.vo.ProductVO"><include refid="productDetail"/> WHERE p.id=#{id}</select>
  <insert id="insertProduct" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO crm_product(category_id,model_code,product_name,brand,series,specifications,image_url,supply_type,unit,retail_price,channel_price,lead_days)
    VALUES(#{categoryId},#{modelCode},#{productName},#{brand},#{series},#{specifications},#{imageUrl},#{supplyType},#{unit},#{retailPrice},#{channelPrice},#{leadDays})
  </insert>
  <update id="updateProduct">
    UPDATE crm_product SET category_id=#{categoryId},product_name=#{productName},brand=#{brand},series=#{series},specifications=#{specifications},image_url=#{imageUrl},
      supply_type=#{supplyType},unit=#{unit},retail_price=#{retailPrice},channel_price=#{channelPrice},lead_days=#{leadDays} WHERE id=#{id}
  </update>
  <update id="productStatus">UPDATE crm_product SET status=#{status} WHERE id=#{id}</update>
  <select id="skus" resultType="com.crm.entity.ProductSku">SELECT * FROM crm_product_sku WHERE product_id=#{productId} ORDER BY id</select>
  <select id="sku" resultType="com.crm.entity.ProductSku">SELECT * FROM crm_product_sku WHERE id=#{id}</select>
  <insert id="insertSku" useGeneratedKeys="true" keyProperty="id">INSERT INTO crm_product_sku(product_id,sku_code,sale_price) VALUES(#{productId},#{skuCode},#{salePrice})</insert>
  <update id="updateSku">UPDATE crm_product_sku SET color=NULL,hand_style=NULL,packaging=NULL,sale_price=#{salePrice} WHERE id=#{id}</update>
  <update id="skuStatus">UPDATE crm_product_sku SET status=#{status} WHERE id=#{id}</update>
</mapper>
