<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.mapper.PermissionMapper">
  <select id="findAll" resultType="com.crm.entity.Permission">SELECT * FROM sys_permission ORDER BY sort_no,id</select>
  <select id="findById" resultType="com.crm.entity.Permission">SELECT * FROM sys_permission WHERE id=#{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sys_permission(parent_id,permission_name,permission_code,permission_type,route_path,component,icon,sort_no,visible,status)
    VALUES(#{parentId},#{permissionName},#{permissionCode},#{permissionType},#{routePath},#{component},#{icon},#{sortNo},#{visible},#{status})
  </insert>
  <update id="update">
    UPDATE sys_permission SET parent_id=#{parentId},permission_name=#{permissionName},route_path=#{routePath},
      component=#{component},icon=#{icon},sort_no=#{sortNo},visible=#{visible},status=#{status} WHERE id=#{id}
  </update>
  <update id="updateStatus">UPDATE sys_permission SET status=#{status} WHERE id=#{id}</update>
  <select id="countChildren" resultType="int">SELECT COUNT(*) FROM sys_permission WHERE parent_id=#{id}</select>
  <select id="countBusinessGrants" resultType="int">
    SELECT COUNT(*) FROM sys_role_permission rp JOIN sys_role r ON r.id=rp.role_id
    WHERE rp.permission_id=#{id} AND r.role_code != 'SUPER_ADMIN'
  </select>
  <insert id="grantAdmin">INSERT INTO sys_role_permission(role_id,permission_id) VALUES(#{roleId},#{permissionId})</insert>
  <delete id="deleteAdminGrant">
    DELETE rp FROM sys_role_permission rp JOIN sys_role r ON r.id=rp.role_id
    WHERE rp.permission_id=#{id} AND r.role_code='SUPER_ADMIN'
  </delete>
  <delete id="delete">DELETE FROM sys_permission WHERE id=#{id}</delete>
</mapper>
